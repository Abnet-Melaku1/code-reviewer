{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Liveness"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Liveness": {
        "enum": [
          "ok"
        ],
        "title": "Liveness",
        "type": "string"
      },
      "Readiness": {
        "enum": [
          "ready",
          "not_ready"
        ],
        "title": "Readiness",
        "type": "string"
      },
      "ReadyResponse": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/Readiness"
          }
        },
        "required": [
          "status"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "CodeReviewer.ai API",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "Liveness: the process is up. Used by the orchestrator to decide restarts.",
        "operationId": "health_healthz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "Readiness: the service can serve traffic.\n\nTrivially ready for now; it will check dependencies (database, Redis) once they are\nwired, and report ``not_ready`` so the orchestrator holds traffic until they are up.",
        "operationId": "health_readyz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readyz",
        "tags": [
          "health"
        ]
      }
    },
    "/webhooks/github": {
      "post": {
        "description": "Intake endpoint receiving GitHub App webhooks and enqueuing worker jobs.",
        "operationId": "webhooks_handle_github_webhook",
        "parameters": [
          {
            "in": "header",
            "name": "x-github-event",
            "required": false,
            "schema": {
              "default": "",
              "title": "X-Github-Event",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-hub-signature-256",
            "required": false,
            "schema": {
              "default": "",
              "title": "X-Hub-Signature-256",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Webhooks Handle Github Webhook",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Handle Github Webhook",
        "tags": [
          "webhooks"
        ]
      }
    }
  }
}
